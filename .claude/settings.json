{
  "permissions": {
    "allow": [
      "Bash(npm run selftest)",
      "Bash(node --check:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(npm run prune-exports -- --dry-run:*)",
      "Bash(npm run export-hermes -- --dry-run:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)",
      "Read(./hermes-ticket/config/**)",
      "Bash(npm start)",
      "Bash(npm run dev)",
      "Bash(npm run login)",
      "Bash(npm run send-report:*)",
      "Bash(npm run jira:*)",
      "Bash(npm run stop)",
      "Bash(npm run resume)"
    ]
  }
}
